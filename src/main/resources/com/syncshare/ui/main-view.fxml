<?xml version="1.0" encoding="UTF-8"?>

<?import com.syncshare.ui.design.ConnectionStatusPill?>
<?import com.syncshare.ui.navigation.SidebarNavigation?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.syncshare.ui.MainController"
            styleClass="app-root">

    <left>
        <VBox styleClass="sidebar" prefWidth="228" minWidth="212" maxWidth="248" spacing="6">
            <HBox styleClass="sidebar-brand" spacing="12">
                <StackPane fx:id="brandMarkContainer" styleClass="sidebar-brand-mark"/>
                <VBox spacing="1" minWidth="0">
                    <Label text="SyncShare" styleClass="sidebar-brand-title"/>
                    <Label text="Secure P2P Transfer" styleClass="sidebar-brand-subtitle"/>
                </VBox>
            </HBox>

            <Label text="NAVIGATION" styleClass="sidebar-section-label"/>

            <SidebarNavigation fx:id="sidebarNavigation"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-footer" spacing="4">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Region fx:id="sidebarConnectionDot" styleClass="status-dot, status-dot-info"/>
                    <Label fx:id="sidebarFooterTitle" text="Standby • Port 5050" styleClass="sidebar-footer-title"/>
                </HBox>
                <Label fx:id="sidebarFooterCaption"
                       text="Mutual TLS 1.3 • SHA-256 Verified"
                       styleClass="sidebar-footer-caption"
                       wrapText="true"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <BorderPane minWidth="0">
            <top>
                <HBox styleClass="app-topbar" spacing="16" alignment="CENTER_LEFT">
                    <VBox styleClass="page-header" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label fx:id="pageTitleLabel"
                               text="Dashboard"
                               styleClass="text-page-title"
                               wrapText="true"/>
                        <Label fx:id="pageSubtitleLabel"
                               text="Connectivity overview, local device identity, and transfer summaries"
                               styleClass="text-caption"
                               wrapText="true"/>
                    </VBox>
                    <HBox fx:id="topbarRightSlot" spacing="10" alignment="CENTER_RIGHT" minWidth="-Infinity">
                        <ConnectionStatusPill fx:id="connectionStatusPill"/>
                        <Button fx:id="quickSendHeaderButton"
                                text="Quick Send"
                                minWidth="-Infinity"
                                onAction="#handleQuickSend"
                                styleClass="btn, btn-primary, btn-sm"/>
                    </HBox>
                </HBox>
            </top>

            <center>
                <ScrollPane fx:id="contentScrollPane"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            styleClass="app-scroll">
                    <content>
                        <StackPane fx:id="viewHost" styleClass="app-view-host"/>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10">
            <Region fx:id="statusDot" styleClass="status-dot, status-dot-success"/>
            <Label fx:id="statusLabel" text="Status: Ready" styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="runtimeInfoLabel" styleClass="runtime-info"/>
        </HBox>
    </bottom>

</BorderPane>
